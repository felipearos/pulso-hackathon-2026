{
  "name": "pulso-hackathon-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "reset": "bun src/patricia/reset-cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src",
    "build": "bun build src/main.ts --target bun --outdir dist",
    "check": "bun run test && bun run typecheck && bun run lint && bun run build",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "pdfjs-dist": "~6.4.299",
    "qrcode": "^1",
    "unpdf": "^1.9.1"
  }
}
